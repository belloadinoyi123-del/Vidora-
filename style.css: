/* =========================================
   VIDORA — PREMIUM UI
========================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #09090f;
  --card: #14141d;
  --card-light: #1c1c27;
  --border: rgba(255,255,255,0.08);

  --purple: #8b5cf6;
  --pink: #ff2d75;
  --blue: #4f8cff;

  --text: #ffffff;
  --muted: #9797a6;

  --gradient:
    linear-gradient(
      135deg,
      #8b5cf6,
      #ff2d75
    );
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  background: var(--bg);
}

body {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at top,
      rgba(139,92,246,0.16),
      transparent 35%
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Inter,
    Arial,
    sans-serif;

  padding-bottom: 90px;
}

button,
input,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.hidden {
  display: none !important;
}


/* =========================================
   AUTH SCREEN
========================================= */

#authScreen {
  min-height: 100vh;

  display: flex;

  justify-content: center;
  align-items: center;

  padding: 20px;

  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(139,92,246,0.35),
      transparent 35%
    ),
    radial-gradient(
      circle at 80% 80%,
      rgba(255,45,117,0.25),
      transparent 35%
    ),
    #09090f;
}

.authBox {
  width: 100%;
  max-width: 420px;

  padding: 32px 25px;

  background:
    rgba(20,20,29,0.85);

  border:
    1px solid rgba(255,255,255,0.1);

  border-radius: 28px;

  box-shadow:
    0 25px 80px
    rgba(0,0,0,0.55);

  backdrop-filter:
    blur(15px);

  animation:
    fadeUp .6s ease;
}

.brand {
  font-size: 48px;

  font-weight: 800;

  letter-spacing: -2px;

  text-align: center;
}

.brand span,
.logo span {
  background:
    var(--gradient);

  -webkit-background-clip: text;

  background-clip: text;

  color: transparent;
}

.tagline {
  color: var(--muted);

  text-align: center;

  margin:
    10px 0 30px;

  font-size: 14px;
}

.authBox input {
  width: 100%;

  padding: 16px;

  margin-bottom: 12px;

  border-radius: 14px;

  border:
    1px solid var(--border);

  background:
    rgba(255,255,255,0.05);

  color: white;

  outline: none;

  font-size: 15px;

  transition: .25s;
}

.authBox input::placeholder {
  color: #777786;
}

.authBox input:focus {
  border-color:
    var(--purple);

  background:
    rgba(139,92,246,0.08);

  box-shadow:
    0 0 0 4px
    rgba(139,92,246,0.12);
}

.authBox button {
  width: 100%;

  padding: 15px;

  margin-top: 8px;

  border: none;

  border-radius: 14px;

  background:
    var(--gradient);

  color: white;

  font-weight: 700;

  font-size: 15px;

  transition:
    transform .2s,
    opacity .2s;
}

.authBox button:active {
  transform:
    scale(.97);
}

.authBox .secondary {
  background:
    rgba(255,255,255,0.07);

  border:
    1px solid
    rgba(255,255,255,0.08);
}

#authMessage {
  min-height: 20px;

  margin-top: 18px;

  text-align: center;

  color: var(--muted);

  font-size: 13px;
}


/* =========================================
   HEADER
========================================= */

header {
  position: sticky;

  top: 0;

  z-index: 100;

  height: 68px;

  display: flex;

  justify-content: space-between;
  align-items: center;

  padding:
    0 18px;

  background:
    rgba(9,9,15,0.82);

  border-bottom:
    1px solid
    rgba(255,255,255,0.06);

  backdrop-filter:
    blur(18px);
}

.logo {
  font-size: 29px;

  font-weight: 800;

  letter-spacing: -1px;
}

.headerButtons {
  display: flex;

  gap: 10px;
}

.headerButtons button {
  width: 42px;
  height: 42px;

  border-radius: 50%;

  border:
    1px solid
    rgba(255,255,255,0.08);

  background:
    rgba(255,255,255,0.06);

  color: white;

  font-size: 18px;

  transition: .2s;
}

.headerButtons button:active {
  transform:
    scale(.9);
}


/* =========================================
   MAIN
========================================= */

main {
  width: 100%;

  max-width: 680px;

  margin: auto;

  padding:
    16px 14px 100px;
}


/* =========================================
   STORIES
========================================= */

.stories {
  display: flex;

  gap: 16px;

  overflow-x: auto;

  padding:
    5px 2px 20px;

  scrollbar-width: none;
}

.stories::-webkit-scrollbar {
  display: none;
}

.story {
  min-width: 65px;

  text-align: center;

  animation:
    fadeUp .5s ease;
}

.storyCircle {
  width: 62px;
  height: 62px;

  display: flex;

  justify-content: center;
  align-items: center;

  margin:
    auto auto 7px;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #8b5cf6,
      #ff2d75
    );

  padding: 3px;

  position: relative;

  box-shadow:
    0 8px 25px
    rgba(139,92,246,0.28);
}

.storyCircle::after {
  content: "";

  position: absolute;

  inset: 4px;

  border-radius: 50%;

  background:
    #20202a;
}

.story small {
  position: relative;

  color: #aaa;

  font-size: 11px;

  white-space: nowrap;
}


/* =========================================
   CARDS
========================================= */

.createCard,
.post,
.profileCard {
  background:
    linear-gradient(
      145deg,
      rgba(29,29,40,0.95),
      rgba(17,17,25,0.95)
    );

  border:
    1px solid
    rgba(255,255,255,0.07);

  border-radius: 22px;

  box-shadow:
    0 12px 35px
    rgba(0,0,0,0.2);
}


/* =========================================
   CREATE POST
========================================= */

.createCard {
  padding: 18px;

  margin-bottom: 18px;
}

.createCard h2 {
  font-size: 19px;

  margin-bottom: 15px;
}

.createCard textarea {
  width: 100%;

  min-height: 95px;

  padding: 15px;

  resize: none;

  border-radius: 15px;

  border:
    1px solid
    rgba(255,255,255,0.08);

  background:
    rgba(0,0,0,0.2);

  color: white;

  outline: none;

  font-size: 14px;
}

.createCard textarea:focus {
  border-color:
    rgba(139,92,246,0.7);
}

.createCard input {
  width: 100%;

  margin-top: 14px;

  color: #aaa;

  font-size: 13px;
}

.createCard button {
  width: 100%;

  padding: 15px;

  margin-top: 15px;

  border: none;

  border-radius: 14px;

  background:
    var(--gradient);

  color: white;

  font-weight: 700;

  font-size: 15px;

  box-shadow:
    0 10px 25px
    rgba(139,92,246,0.25);

  transition:
    .2s;
}

.createCard button:active {
  transform:
    scale(.98);
}

#uploadMessage {
  min-height: 18px;

  margin-top: 12px;

  color: var(--muted);

  font-size: 13px;

  text-align: center;
}


/* =========================================
   POSTS
========================================= */

.post {
  overflow: hidden;

  padding: 0;

  margin-bottom: 18px;

  animation:
    fadeUp .45s ease;
}

.postHeader {
  display: flex;

  align-items: center;

  gap: 11px;

  padding: 15px;
}

.avatar {
  width: 46px;
  height: 46px;

  flex-shrink: 0;

  display: flex;

  justify-content: center;
  align-items: center;

  border-radius: 50%;

  background:
    var(--gradient);

  color: white;

  font-weight: 800;

  box-shadow:
    0 6px 20px
    rgba(139,92,246,0.3);
}

.postUser {
  font-size: 14px;

  font-weight: 700;
}

.postTime {
  color: #777786;

  font-size: 11px;

  margin-top: 3px;
}

.postCaption {
  padding:
    0 15px 14px;

  color: #e2e2e8;

  font-size: 14px;

  line-height: 1.55;
}


/* =========================================
   MEDIA
========================================= */

.postMedia {
  width: 100%;

  max-height: 700px;

  display: block;

  object-fit: contain;

  background:
    #050507;

  border-top:
    1px solid
    rgba(255,255,255,0.04);

  border-bottom:
    1px solid
    rgba(255,255,255,0.04);
}


/* =========================================
   ACTION BUTTONS
========================================= */

.actions {
  display: flex;

  gap: 8px;

  padding:
    14px 15px;
}

.actions button {
  flex: 1;

  padding: 11px 8px;

  border:
    1px solid
    rgba(255,255,255,0.07);

  border-radius: 12px;

  background:
    rgba(255,255,255,0.05);

  color: #ddd;

  font-size: 13px;

  font-weight: 600;

  transition:
    .2s;
}

.actions button:hover {
  background:
    rgba(255,255,255,0.09);
}

.actions button:active {
  transform:
    scale(.96);
}

.actions button.liked {
  color:
    var(--pink);

  background:
    rgba(255,45,117,0.1);

  border-color:
    rgba(255,45,117,0.2);
}


/* =========================================
   COMMENTS
========================================= */

.comments {
  padding:
    14px 15px 16px;

  border-top:
    1px solid
    rgba(255,255,255,0.06);
}

.comments > strong {
  display: block;

  margin-bottom: 8px;

  font-size: 14px;
}

.comment {
  padding:
    9px 0;

  color: #c7c7d0;

  font-size: 13px;

  line-height: 1.5;

  border-bottom:
    1px solid
    rgba(255,255,255,0.04);
}

.comment strong {
  color: white;

  margin-right: 5px;
}

.commentForm {
  display: flex;

  gap: 8px;

  margin-top: 12px;
}

.commentForm input {
  flex: 1;

  min-width: 0;

  padding:
    11px 13px;

  border-radius: 12px;

  border:
    1px solid
    rgba(255,255,255,0.08);

  background:
    #101017;

  color: white;

  outline: none;
}

.commentForm input:focus {
  border-color:
    var(--purple);
}

.commentForm button {
  padding:
    10px 15px;

  border: none;

  border-radius: 12px;

  background:
    var(--gradient);

  color: white;

  font-weight: 600;
}


/* =========================================
   PROFILE
========================================= */

.profileCard {
  padding: 30px 20px;

  text-align: center;
}

.profileAvatar {
  width: 105px;
  height: 105px;

  display: grid;

  place-items: center;

  margin:
    5px auto 18px;

  border-radius: 50%;

  background:
    var(--gradient);

  border:
    5px solid
    rgba(255,255,255,0.08);

  font-size: 40px;

  font-weight: 800;

  box-shadow:
    0 15px 40px
    rgba(139,92,246,0.3);
}

#profileUsername {
  font-size: 22px;
}

#profileEmail {
  color: var(--muted);

  margin:
    8px 0 24px;

  font-size: 13px;
}

#logoutBtn {
  width: 100%;

  padding: 14px;

  border:
    1px solid
    rgba(255,255,255,0.08);

  border-radius: 14px;

  background:
    rgba(255,255,255,0.06);

  color: white;

  font-weight: 700;
}


/* =========================================
   DISCOVER
========================================= */

.searchBox {
  margin-bottom: 18px;
}

.searchBox input {
  width: 100%;

  padding:
    15px 17px;

  border-radius: 16px;

  border:
    1px solid
    rgba(255,255,255,0.08);

  background:
    #181820;

  color: white;

  outline: none;

  font-size: 14px;
}

.searchBox input:focus {
  border-color:
    var(--purple);
}


/* =========================================
   BOTTOM NAVIGATION
========================================= */

.bottomNav {
  position: fixed;

  bottom: 0;

  left: 0;
  right: 0;

  z-index: 200;

  height: 76px;

  display: flex;

  justify-content: space-around;

  padding:
    8px 5px 12px;

  background:
    rgba(15,15,23,0.9);

  border-top:
    1px solid
    rgba(255,255,255,0.07);

  backdrop-filter:
    blur(18px);
}

.navButton {
  flex: 1;

  border: none;

  background:
    transparent;

  color:
    #777786;

  font-size:
    11px;

  transition:
    .2s;
}

.navButton span {
  display: block;

  font-size:
    22px;

  margin-bottom:
    4px;
}

.navButton.active {
  color:
    white;
}

.navButton.active span {
  color:
    var(--purple);
}

.createButton span {
  width: 45px;
  height: 45px;

  display: grid;

  place-items: center;

  margin:
    -18px auto 3px;

  border-radius: 16px;

  background:
    var(--gradient);

  color: white;

  font-size: 28px;

  box-shadow:
    0 10px 30px
    rgba(139,92,246,0.45);
}


/* =========================================
   LOADING
========================================= */

.loading {
  padding: 35px;

  text-align: center;

  color:
    var(--muted);
}


/* =========================================
   ANIMATIONS
========================================= */

@keyframes fadeUp {

  from {
    opacity: 0;

    transform:
      translateY(15px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }

}


/* =========================================
   TABLET / DESKTOP
========================================= */

@media (min-width: 700px) {

  body {
    background:
      radial-gradient(
        circle at top,
        rgba(139,92,246,0.12),
        transparent 40%
      ),
      #09090f;
  }

  main {
    padding-top: 25px;
  }

  .bottomNav {
    width: 680px;

    left: 50%;

    right: auto;

    transform:
      translateX(-50%);

    border-radius:
      20px 20px 0 0;
  }

}
