/* =========================================
   VIDORA — PREMIUM UI
========================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #09090f;
  --card: #14141d;
  --card-light: #1c1c27;
  --border: rgba(255,255,255,0.08);

  --purple: #8b5cf6;
  --pink: #ff2d75;
  --blue: #4f8cff;

  --text: #ffffff;
  --muted: #9797a6;

  --gradient:
    linear-gradient(
      135deg,
      #8b5cf6,
      #ff2d75
    );
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  background: var(--bg);
}

body {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at top,
      rgba(139,92,246,0.16),
      transparent 35%
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Inter,
    Arial,
    sans-serif;

  padding-bottom: 90px;
}

button,
input,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.hidden {
  display: none !important;
}


/* =========================================
   AUTH SCREEN
========================================= */

#authScreen {
  min-height: 100vh;

  display: flex;

  justify-content: center;
  align-items: center;

  padding: 20px;

  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(139,92,246,0.35),
      transparent 35%
    ),
    radial-gradient(
      circle at 80% 80%,
      rgba(255,45,117,0.25),
      transparent 35%
    ),
    #09090f;
}

.authBox {
  width: 100%;
  max-width: 420px;

  padding: 32px 25px;

  background:
    rgba(20,20,29,0.85);

  border:
    1px solid rgba(255,255,255,0.1);

  border-radius: 28px;

  box-shadow:
    0 25px 80px
    rgba(0,0,0,0.55);

  backdrop-filter:
    blur(15px);

  animation:
    fadeUp .6s ease;
}

.brand {
  font-size: 48px;

  font-weight: 800;

  letter-spacing: -2px;

  text-align: center;
}

.brand span,
.logo span {
  background:
    var(--gradient);

  -webkit-background-clip: text;

  background-clip: text;

  color: transparent;
}

.tagline {
  color: var(--muted);

  text-align: center;

  margin:
    10px 0 30px;

  font-size: 14px;
}

.authBox input {
  width: 100%;

  padding: 16px;

  margin-bottom: 12px;

  border-radius: 14px;

  border:
    1px solid var(--border);

  background:
    rgba(255,255,255,0.05);

  color: white;

  outline: none;

  font-size: 15px;

  transition: .25s;
}

.authBox input::placeholder {
  color: #777786;
}

.authBox input:focus {
  border-color:
    var(--purple);

  background:
    rgba(139,92,246,0.08);

  box-shadow:
    0 0 0 4px
    rgba(139,92,246,0.12);
}

.authBox button {
  width: 100%;

  padding: 15px;

  margin-top: 8px;

  border: none;

  border-radius: 14px;

  background:
    var(--gradient);

  color: white;

  font-weight: 700;

  font-size: 15px;

  transition:
    transform .2s,
    opacity .2s;
}

.authBox button:active {
  transform:
    scale(.97);
}

.authBox .secondary {
  background:
    rgba(255,255,255,0.07);

  border:
    1px solid
    rgba(255,255,255,0.08);
}

#authMessage {
  min-height: 20px;

  margin-top: 18px;

  text-align: center;

  color: var(--muted);

  font-size: 13px;
}


/* =========================================
   HEADER
========================================= */

header {
  position: sticky;

  top: 0;

  z-index: 100;

  height: 68px;

  display: flex;

  justify-content: space-between;
  align-items: center;

  padding:
    0 18px;

  background:
    rgba(9,9,15,0.82);

  border-bottom:
    1px solid
    rgba(255,255,255,0.06);

  backdrop-filter:
    blur(18px);
}

.logo {
  font-size: 29px;

  font-weight: 800;

  letter-spacing: -1px;
}

.headerButtons {
  display: flex;

  gap: 10px;
}

.headerButtons button {
  width: 42px;
  height: 42px;

  border-radius: 50%;

  border:
    1px solid
    rgba(255,255,255,0.08);

  background:
    rgba(255,255,255,0.06);

  color: white;

  font-size: 18px;

  transition: .2s;
}

.headerButtons button:active {
  transform:
    scale(.9);
}


/* =========================================
   MAIN
========================================= */

main {
  width: 100%;

  max-width: 680px;

  margin: auto;

  padding:
    16px 14px 100px;
}


/* =========================================
   STORIES
========================================= */

.stories {
  display: flex;

  gap: 16px;

  overflow-x: auto;

  padding:
    5px 2px 20px;

  scrollbar-width: none;
}

.stories::-webkit-scrollbar {
  display: none;
}

.story {
  min-width: 65px;

  text-align: center;

  animation:
    fadeUp .5s ease;
}

.storyCircle {
  width: 62px;
  height: 62px;

  display: flex;

  justify-content: center;
  align-items: center;

  margin:
    auto auto 7px;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #8b5cf6,
      #ff2d75
    );

  padding: 3px;

  position: relative;

  box-shadow:
    0 8px 25px
    rgba(139,92,246,0.28);
}

.storyCircle::after {
  content: "";

  position: absolute;

  inset: 4px;

  border-radius: 50%;

  background:
    #20202a;
}

.story small {
  position: relative;

  color: #aaa;

  font-size: 11px;

  white-space: nowrap;
}


/* =========================================
   CARDS
========================================= */

.createCard,
.post,
.profileCard {
  background:
    linear-gradient(
      145deg,
      rgba(29,29,40,0.95),
      rgba(17,17,25,0.95)
    );

  border:
    1px solid
    rgba(255,255,255,0.07);

  border-radius: 22px;

  box-shadow:
    0 12px 35px
    rgba(0,0,0,0.2);
}


