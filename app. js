   5. PROFILE
========================================================= */

async function loadProfile() {

  try {

    const {
      data,
      error
    } =
      await supabaseClient.auth.getUser();


    if (error) {

      console.error(
        "Get user error:",
        error
      );

      return;
    }


    const user =
      data?.user;


    if (!user) {
      return;
    }


    /* Email */

    const profileEmail =
      $("profileEmail");


    if (profileEmail) {

      profileEmail.textContent =
        user.email || "No email";

    }


    /* Default username */

    let username =
      "Vidora User";


    /*
      Try to get profile.
      This requires a profiles table with
      an id column matching auth.users.id.
    */

    const {
      data: profile,
      error: profileError
    } =
      await supabaseClient
        .from("profiles")
        .select("*")
        .eq("id", user.id)
        .maybeSingle();


    if (!profileError && profile) {

      username =
        profile.username ||
        "Vidora User";

    }


    /* Username */

    const profileUsername =
      $("profileUsername");


    if (profileUsername) {

      if (
        username === "Vidora User"
      ) {

        profileUsername.textContent =
          username;

      } else {

        profileUsername.textContent =
          "@" + username;

      }

    }


    /* Avatar */

    const avatar =
      document.querySelector(
        ".profileAvatar"
      );


    if (avatar) {

      avatar.textContent =
        username
          .charAt(0)
          .toUpperCase();

    }

  } catch (error) {

    console.error(
      "loadProfile error:",
      error
    );

  }

}


