/* ---------------------------------------------------------
   SIGN UP
--------------------------------------------------------- */

async function signUp() {

  const emailElement = $("email");
  const passwordElement = $("password");
  const button = $("signUpBtn");

  if (!emailElement || !passwordElement) {
    return;
  }

  const email =
    emailElement.value.trim();

  const password =
    passwordElement.value;


  /* Validation */

  if (!email) {

    setAuthMessage(
      "Enter your email address."
    );

    emailElement.focus();

    return;
  }


  if (!password) {

    setAuthMessage(
      "Enter a password."
    );

    passwordElement.focus();

    return;
  }


  if (password.length < 6) {

    setAuthMessage(
      "Password must be at least 6 characters."
    );

    passwordElement.focus();

    return;
  }


  /* Disable button */

  if (button) {
    button.disabled = true;
    button.textContent = "Creating account...";
  }

  setAuthMessage(
    "Creating your Vidora account..."
  );


  try {

    const {
      data,
      error
    } =
      await supabaseClient.auth.signUp({
        email: email,
        password: password
      });


    if (error) {

      console.error(
        "Signup error:",
        error
      );

      setAuthMessage(
        error.message
      );

      return;
    }


    if (!data || !data.user) {

      setAuthMessage(
        "Account could not be created."
      );

      return;
    }


    /*
      If Supabase email confirmation is enabled,
      Supabase normally returns a user but no session.
    */

    if (!data.session) {

      setAuthMessage(
        "Account created! Check your email to verify your account before logging in."
      );

      return;
    }


    /* Account created and session available */

    setAuthMessage(
      "Account created successfully!"
    );


    await showApp(
      data.session
    );

  } catch (error) {

    console.error(
      "Unexpected signup error:",
      error
    );

    setAuthMessage(
      error.message ||
      "Something went wrong during signup."
    );

  } finally {

    if (button) {
      button.disabled = false;
      button.textContent = "Create Account";
    }

  }

}


