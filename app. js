/* =========================================================
   18. NAVIGATION ACTIVE STATE
   ========================================================= */

function updateNavigation(pageName) {

  const buttons =
    document.querySelectorAll(
      ".navButton"
    );

  buttons.forEach(function(button) {

    button.classList.remove(
      "active"
    );

  });

  buttons.forEach(function(button) {

    const text =
      button.textContent
        .trim()
        .toLowerCase();

    if (
      pageName === "home" &&
      text.includes("home")
    ) {
      button.classList.add("active");
    }

    if (
      pageName === "discover" &&
      text.includes("discover")
    ) {
      button.classList.add("active");
    }

    if (
      pageName === "create" &&
      text.includes("create")
    ) {
      button.classList.add("active");
    }

    if (
      pageName === "chat" &&
      text.includes("chat")
    ) {
      button.classList.add("active");
    }

    if (
      pageName === "profile" &&
      text.includes("profile")
    ) {
      button.classList.add("active");
    }

  });
}


/* =========================================================
   19. SEARCH
   ========================================================= */

let searchTimer = null;


async function searchPosts() {

  clearTimeout(searchTimer);

  searchTimer =
    setTimeout(
      async function() {

        const input =
          $("searchInput");

        const results =
          $("discoverResults");

        if (!input || !results) {
          return;
        }

        const query =
          input.value
            .trim()
            .toLowerCase();

        if (!query) {

          results.innerHTML =
            `
              <div class="loading">
                Discover what's trending.
              </div>
            `;

          return;
        }

        results.innerHTML =
          `
            <div class="loading">
              Searching...
            </div>
          `;

        try {

          /*
            Search captions.

            This only requires the posts table.
          */

          const result =
            await supabaseClient
              .from("posts")
              .select(
                "id,user_id,media_url,media_type,caption,created_at"
              )
              .ilike(
                "caption",
                "%" + query + "%"
              )
              .order(
                "created_at",
                {
                  ascending: false
                }
              );

          const data = result.data;
          const error = result.error;

          if (error) {

            results.innerHTML =
              `
                <div class="post">
                  <p>${escapeHTML(
                    error.message
                  )}</p>
                </div>
              `;

            return;
          }

          if (!data || data.length === 0) {

            results.innerHTML =
              `
                <div class="post">
                  <h3>No results</h3>
                  <p>No posts matched your search.</p>
                </div>
              `;

            return;
          }

          results.innerHTML = "";

          data.forEach(function(post) {

            results.appendChild(
              createPostElement(post)
            );

          });

        } catch (error) {

          console.error(
            "Search error:",
            error
          );

          results.innerHTML =
            `
              <div class="post">
                <p>${escapeHTML(
                  error.message
                )}</p>
              </div>
            `;
        }

      },
      300
    );
}


