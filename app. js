/* =========================================================
   16. GET LIKE COUNT
   ========================================================= */

async function getLikeCount(postId) {
  if (!supabaseClient) {
    return 0;
  }

  try {
    const result =
      await supabaseClient
        .from("likes")
        .select(
          "id",
          {
            count: "exact",
            head: true
          }
        )
        .eq(
          "post_id",
          postId
        );

    if (result.error) {
      return 0;
    }

    return result.count || 0;

  } catch (error) {
    return 0;
  }
}


/* =========================================================
   17. GET COMMENTS
   ========================================================= */

async function getComments(postId) {
  if (!supabaseClient) {
    return [];
  }

  try {
    const result =
      await supabaseClient
        .from("comments")
        .select(
          "id,user_id,body,created_at"
        )
        .eq(
          "post_id",
          postId
        )
        .order(
          "created_at",
          {
            ascending: true
          }
        );

    if (result.error) {
      return [];
    }

    const comments =
      result.data || [];

    const finalComments = [];

    for (const comment of comments) {
      const username =
        await getUsername(
          comment.user_id
        );

      finalComments.push({
        id: comment.id,
        body: comment.body,
        created_at: comment.created_at,
        username: username
      });
    }

    return finalComments;

  } catch (error) {
    return [];
  }
}


/* =========================================================
   18. LIKE / UNLIKE
   ========================================================= */

async function toggleLike(postId) {
  if (!supabaseClient) {
    return;
  }

  try {
    const userResult =
      await supabaseClient.auth.getUser();

    const user = userResult.data
      ? userResult.data.user
      : null;

    if (!user) {
      alert("Please log in first.");
      return;
    }

    const existing =
      await supabaseClient
        .from("likes")
        .select("id")
        .eq(
          "post_id",
          postId
        )
        .eq(
          "user_id",
          user.id
        )
        .maybeSingle();

    if (existing.error) {
      console.error(
        "Like check error:",
        existing.error
      );
      return;
    }

    if (existing.data) {
      const deleteResult =
        await supabaseClient
          .from("likes")
          .delete()
          .eq(
            "id",
            existing.data.id
          );

      if (deleteResult.error) {
        console.error(
          "Unlike error:",
          deleteResult.error
        );
      }

    } else {
      const insertResult =
        await supabaseClient
          .from("likes")
          .insert({
            post_id: postId,
            user_id: user.id
          });

      if (insertResult.error) {
        console.error(
          "Like error:",
          insertResult.error
        );
      }
    }

    await loadFeed();

  } catch (error) {
    console.error(
      "Like error:",
      error
    );
  }
}


