}


/* =========================================================
   13. LOAD FEED
   ========================================================= */

async function loadFeed() {
  const feed = $("feed");

  if (!feed) {
    return;
  }

  if (!supabaseClient) {
    feed.innerHTML =
      "<p>Supabase is not connected.</p>";
    return;
  }

  feed.innerHTML =
    "<p>Loading posts...</p>";

  try {
    const result =
      await supabaseClient
        .from("posts")
        .select(
          "id,user_id,media_url,media_type,caption,created_at"
        )
        .order(
          "created_at",
          {
            ascending: false
          }
        );

    if (result.error) {
      console.error(
        "Feed error:",
        result.error
      );

      feed.innerHTML =
        "<p>Could not load posts.</p>" +
        "<small>" +
        escapeHTML(result.error.message) +
        "</small>";

      return;
    }

    const posts =
      result.data || [];

    if (!posts.length) {
      feed.innerHTML =
        "<p>No posts yet. Be the first to post!</p>";

      return;
    }

    feed.innerHTML = "";

    for (const post of posts) {
      const element =
        await createPostElement(post);

      feed.appendChild(element);
    }

  } catch (error) {
    console.error(
      "Feed loading error:",
      error
    );

    feed.innerHTML =
      "<p>Unable to load feed.</p>";
  }
}


/* =========================================================
   14. CREATE POST ELEMENT
   ========================================================= */

async function createPostElement(post) {
  const container =
    document.createElement("article");

  container.className = "post";

  const username =
    await getUsername(post.user_id);

  const likeCount =
    await getLikeCount(post.id);

  const commentList =
    await getComments(post.id);

  let mediaHTML = "";

  if (post.media_type === "video") {
    mediaHTML = `
      <video
        class="postMedia"
        src="${escapeHTML(post.media_url)}"
        controls
        playsinline
        preload="metadata">
      </video>
    `;
  } else {
    mediaHTML = `
      <img
        class="postMedia"
        src="${escapeHTML(post.media_url)}"
        alt="Vidora post"
        loading="lazy">
    `;
  }

  let commentsHTML = "";

  if (commentList.length) {
    commentsHTML = `
      <div class="comments">
        ${commentList.map(function(comment) {
          return `
            <div class="comment">
              <strong>
                ${escapeHTML(
                  comment.username
                )}
              </strong>
              <span>
                ${escapeHTML(
                  comment.body
                )}
              </span>
            </div>
          `;
        }).join("")}
      </div>
    `;
  }

  container.innerHTML = `
    <div class="postHeader">
      <strong>
        @${escapeHTML(username)}
      </strong>

      <small>
        ${escapeHTML(
          formatDate(post.created_at)
        )}
      </small>
    </div>

    ${mediaHTML}

    ${
      post.caption
        ? `
          <div class="postCaption">
            ${escapeHTML(post.caption)}
          </div>
        `
        : ""
    }

    <div class="postActions">

      <button
        type="button"
        onclick="toggleLike('${escapeHTML(post.id)}')">
        ❤️
        <span>
          ${likeCount}
        </span>
      </button>

      <button
        type="button"
        onclick="sharePost('${escapeHTML(post.media_url)}')">
        🔗 Share
      </button>

    </div>

    ${commentsHTML}

    <div class="commentBox">

      <input
        type="text"
        id="comment-${escapeHTML(post.id)}"
        placeholder="Write a comment...">

      <button
        type="button"
        onclick="addComment('${escapeHTML(post.id)}')">
        Comment
      </button>

    </div>
  `;

  return container;
}


