/* =========================================================
   8. CREATE POST
========================================================= */

async function createPost(
  file,
  caption,
  messageId,
  fileInputId,
  captionInputId
) {

  const message =
    $(messageId);


  try {

    /* Get logged-in user */

    const {
      data,
      error: userError
    } =
      await supabaseClient.auth.getUser();


    if (userError) {

      if (message) {
        message.textContent =
          userError.message;
      }

      return false;
    }


    const user =
      data?.user;


    if (!user) {

      if (message) {
        message.textContent =
          "Please log in again.";
      }

      return false;
    }


    if (message) {
      message.textContent =
        "Uploading...";
    }


    /* Validate file */

    if (!file.type.startsWith("image/") &&
        !file.type.startsWith("video/")) {

      if (message) {
        message.textContent =
          "Only images and videos are allowed.";
      }

      return false;
    }


    /*
      Get file extension.
    */

    let extension =
      file.name
        .split(".")
        .pop()
        .toLowerCase();


    if (!extension) {

      extension =
        file.type.startsWith("video/")
          ? "mp4"
          : "jpg";

    }


    /*
      Generate unique filename.
    */

    const randomName =
      typeof crypto !== "undefined" &&
      crypto.randomUUID
        ? crypto.randomUUID()
        : Date.now().toString();


    const filePath =
      user.id +
      "/" +
      randomName +
      "." +
      extension;


    /* -----------------------------------------------------
       UPLOAD MEDIA TO SUPABASE STORAGE
    ----------------------------------------------------- */

    const {
      error: uploadError
    } =
      await supabaseClient
        .storage
        .from("media")
        .upload(
          filePath,
          file,
          {
            contentType:
              file.type,

            upsert:
              false
          }
        );


    if (uploadError) {

      console.error(
        "Storage upload error:",
        uploadError
      );

      if (message) {
        message.textContent =
          uploadError.message;
      }

      return false;
    }


    /* -----------------------------------------------------
       GET PUBLIC URL
    ----------------------------------------------------- */

    const {
      data: publicData
    } =
      supabaseClient
        .storage
        .from("media")
        .getPublicUrl(
          filePath
        );


    if (!publicData?.publicUrl) {

      if (message) {
        message.textContent =
          "Could not create media URL.";
      }

      return false;
    }


    /* -----------------------------------------------------
       DETERMINE MEDIA TYPE
    ----------------------------------------------------- */

    const mediaType =
      file.type.startsWith("video/")
        ? "video"
        : "image";


    /* -----------------------------------------------------
       INSERT POST INTO DATABASE
    ----------------------------------------------------- */

    const {
      error: postError
    } =
      await supabaseClient
        .from("posts")
        .insert({

          user_id:
            user.id,

          media_url:
            publicData.publicUrl,

          media_type:
            mediaType,

          caption:
            caption || null

        });


    if (postError) {

      console.error(
        "Post database error:",
        postError
      );


      /*
        The media uploaded successfully but
        database insertion failed.
      */

      if (message) {
        message.textContent =
          postError.message;
      }

      return false;
    }


    /* Success */

    if (message) {
      message.textContent =
        "Published successfully!";
    }


    /* Clear inputs */

    const fileInput =
      $(fileInputId);

    const captionInput =
      $(captionInputId);


    if (fileInput) {
      fileInput.value = "";
    }


    if (captionInput) {
      captionInput.value = "";
    }


    /* Refresh feed */

    await loadFeed();


    return true;

  } catch (error) {

    console.error(
      "createPost error:",
      error
    );


    if (message) {
      message.textContent =
        error.message ||
        "Unable to publish post.";
    }


    return false;

  }

}


