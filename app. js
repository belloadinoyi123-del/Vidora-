/* =========================================================
   9. VALIDATE MEDIA FILE
   ========================================================= */

function validateMediaFile(file) {
  if (!file) {
    return {
      valid: false,
      message: "Please select an image or video."
    };
  }

  /*
    50 MB maximum.
    This matches the limit you mentioned.
  */

  const MAX_SIZE = 50 * 1024 * 1024;

  if (file.size > MAX_SIZE) {
    return {
      valid: false,
      message: "File is larger than 50 MB."
    };
  }

  const isImage =
    file.type.startsWith("image/");

  const isVideo =
    file.type.startsWith("video/");

  if (!isImage && !isVideo) {
    return {
      valid: false,
      message:
        "Only image and video files are supported."
    };
  }

  return {
    valid: true,
    message: ""
  };
}


