/* =========================================
   SHARE
========================================= */

async function sharePost(post) {

  try {

    if (
      navigator.share
    ) {

      await navigator.share({

        title:
          "Vidora",

        text:
          "Check out this Vidora post!",

        url:
          post.media_url

      });

    } else {

      await navigator.clipboard.writeText(
        post.media_url
      );


      alert(
        "Post link copied!"
      );

    }

  } catch (error) {

    console.log(
      "Share cancelled:",
      error
    );

  }

}


/* =========================================
   PAGE NAVIGATION
========================================= */

/*
 Your HTML uses both:

 showPage(...)

 and

 showpage(...)

 JavaScript is case-sensitive,
 so both functions are provided.
*/

function showPage(
  pageName
) {

  const screens = [
    "home",
    "discover",
    "create",
    "chat",
    "profile",
    "notifications"
  ];


  screens.forEach(
    name => {

      const screen =
        $(name + "Screen");


      if (screen) {

        screen.classList.add(
          "hidden"
        );

      }

    }
  );


  const selectedScreen =
    $(pageName + "Screen");


  if (selectedScreen) {

    selectedScreen.classList.remove(
      "hidden"
    );

  }


  updateNavigation(
    pageName
  );


  if (
    pageName ===
    "profile"
  ) {

    loadProfile();

  }


  if (
    pageName ===
    "home"
  ) {

    loadFeed();

  }

}


/*
 Lowercase version because
 your bottom navigation uses
 showpage(...)
*/

function showpage(
  pageName
) {

  showPage(
    pageName
  );

}


/* =========================================
   NAVIGATION ACTIVE STATE
========================================= */

function updateNavigation(
  pageName
) {

  const buttons =
    document.querySelectorAll(
      ".navButton"
    );


  buttons.forEach(
    button => {

      button.classList.remove(
        "active"
      );

    }
  );


  buttons.forEach(
    button => {

      const text =
        button.textContent
          .trim()
          .toLowerCase();


      if (
        pageName === "home" &&
        text.includes("home")
      ) {

        button.classList.add(
          "active"
        );

      }


      if (
        pageName === "discover" &&
        text.includes("discover")
      ) {

        button.classList.add(
          "active"
        );

      }


      if (
        pageName === "create" &&
        text.includes("create")
      ) {

        button.classList.add(
          "active"
        );

      }


      if (
        pageName === "chat" &&
        text.includes("chat")
      ) {

        button.classList.add(
          "active"
        );

      }


      if (
        pageName === "profile" &&
        text.includes("profile")
      ) {

        button.classList.add(
          "active"
        );

      }

    }
  );

}


