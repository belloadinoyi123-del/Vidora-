async function addComment(
  postId,
  body
) {

  try {

    const result =
      await supabaseClient.auth.getUser();

    const user = result.data?.user;

    if (!user) {

      alert(
        "Please log in to comment."
      );

      return false;
    }

    const insertResult =
      await supabaseClient
        .from("comments")
        .insert({
          post_id: postId,
          user_id: user.id,
          body: body
        });

    if (insertResult.error) {

      alert(
        "Comments are not configured yet: " +
        insertResult.error.message
      );

      return false;
    }

    await loadFeed();

    return true;

  } catch (error) {

    console.error(
      "Comment error:",
      error
    );

    alert(
      error.message ||
      "Could not add comment."
    );

    return false;
  }
}


/* =========================================================
   16. SHARE
   ========================================================= */

async function sharePost(post) {

  try {

    if (
      navigator.share
    ) {

      await navigator.share({
        title: "Vidora",
        text: "Check out this Vidora post!",
        url: post.media_url
      });

      return;
    }

    if (
      navigator.clipboard &&
      navigator.clipboard.writeText
    ) {

      await navigator.clipboard.writeText(
        post.media_url
      );

      alert(
        "Post link copied!"
      );

      return;
    }

    alert(
      post.media_url
    );

  } catch (error) {

    console.log(
      "Share cancelled:",
      error
    );
  }
}


/* =========================================================
   17. PAGE NAVIGATION
   ========================================================= */

function showPage(pageName) {

  const pages = [
    "home",
    "discover",
    "create",
    "chat",
    "profile",
    "notifications"
  ];

  pages.forEach(function(name) {

    const screen =
      $(name + "Screen");

    if (screen) {
      screen.classList.add("hidden");
    }

  });

  const selected =
    $(pageName + "Screen");

  if (selected) {
    selected.classList.remove("hidden");
  }

  updateNavigation(pageName);

  if (pageName === "home") {
    loadFeed();
  }

  if (pageName === "profile") {
    loadProfile();
  }

  if (pageName === "discover") {
    searchPosts();
  }
}


