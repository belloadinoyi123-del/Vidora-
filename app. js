/* =========================================
   CREATE POST
========================================= */

async function createPost(
  file,
  caption,
  messageId,
  fileInputId,
  captionInputId
) {

  const message =
    $(messageId);


  try {

    const {
      data: {
        user
      }
    } =
      await supabaseClient.auth.getUser();


    if (!user) {

      message.textContent =
        "Please log in again.";

      return false;
    }


    message.textContent =
      "Uploading...";


    const extension =
      file.name
        .split(".")
        .pop()
        .toLowerCase();


    const filePath =
      user.id +
      "/" +
      crypto.randomUUID() +
      "." +
      extension;


    const {
      error: uploadError
    } =
      await supabaseClient.storage
        .from("media")
        .upload(
          filePath,
          file,
          {
            contentType:
              file.type,

            upsert:
              false
          }
        );


    if (uploadError) {

      message.textContent =
        uploadError.message;

      return false;
    }


    const {
      data: publicData
    } =
      supabaseClient.storage
        .from("media")
        .getPublicUrl(
          filePath
        );


    const mediaType =
      file.type.startsWith("video/")
        ? "video"
        : "image";


    const {
      error: postError
    } =
      await supabaseClient
        .from("posts")
        .insert({

          user_id:
            user.id,

          media_url:
            publicData.publicUrl,

          media_type:
            mediaType,

          caption:
            caption

        });


    if (postError) {

      message.textContent =
        postError.message;

      return false;
    }


    message.textContent =
      "Published successfully!";


    $(fileInputId).value = "";

    $(captionInputId).value = "";


    await loadFeed();


    return true;

  } catch (error) {

    console.error(
      "Create post error:",
      error
    );


    message.textContent =
      error.message;


    return false;

  }

}


/* =========================================
   LOAD FEED
========================================= */

async function loadFeed() {

  const feed =
    $("feed");


  if (!feed) {
    return;
  }


  feed.innerHTML =
    `<div class="loading">
      Loading Vidora...
    </div>`;


  try {

    const {
      data,
      error
    } =
      await supabaseClient
        .from("posts")
        .select(`
          id,
          user_id,
          media_url,
          media_type,
          caption,
          created_at,
          profiles (
            username,
            avatar_url
          ),
          likes (
            id,
            user_id
          ),
          comments (
            id,
            user_id,
            body,
            created_at,
            profiles (
              username
            )
          )
        `)
        .order(
          "created_at",
          {
            ascending:
              false
          }
        );


    if (error) {

      feed.innerHTML =
        `<div class="post">
          ${escapeHTML(error.message)}
        </div>`;

      return;
    }


    if (!data || data.length === 0) {

      feed.innerHTML =
        `<div class="post">
          <h3>No posts yet</h3>
          <p>Be the first person to upload!</p>
        </div>`;

      return;
    }


    feed.innerHTML = "";


    data.forEach(
      post => {

        feed.appendChild(
          createPostElement(
            post
          )
        );

      }
    );

  } catch (error) {

    feed.innerHTML =
      `<div class="post">
        ${escapeHTML(error.message)}
      </div>`;

  }

}


/* =========================================
   CREATE POST ELEMENT
========================================= */

function createPostElement(post) {

  const article =
    document.createElement(
      "article"
    );


  article.className =
    "post";


  const username =
    post.profiles?.username ||
    "Vidora User";


  const firstLetter =
    username
      .charAt(0)
      .toUpperCase();


  let mediaHTML = "";


  if (
    post.media_type ===
    "video"
  ) {

    mediaHTML = `
      <video
        class="postMedia"
        controls
        playsinline
        preload="metadata"
        src="${escapeHTML(post.media_url)}">
      </video>
    `;

  } else {

    mediaHTML = `
      <img
        class="postMedia"
        src="${escapeHTML(post.media_url)}"
        alt="Vidora post">
    `;

  }


  const comments =
    (post.comments || [])
      .map(
        comment => {

          const name =
            comment.profiles?.username ||
            "User";


          return `
            <div class="comment">
              <strong>
                @${escapeHTML(name)}
              </strong>

              ${escapeHTML(comment.body)}
            </div>
          `;

        }
      )
      .join("");


  const likeCount =
    (post.likes || []).length;


  article.innerHTML = `

    <div class="postHeader">

      <div class="avatar">
        ${escapeHTML(firstLetter)}
      </div>

      <div>

        <div class="postUser">
          @${escapeHTML(username)}
        </div>

        <div class="postTime">
          ${new Date(
            post.created_at
          ).toLocaleString()}
        </div>

      </div>

    </div>


    ${
      post.caption
        ? `
          <div class="postCaption">
            ${escapeHTML(
              post.caption
            )}
          </div>
        `
        : ""
    }


    ${mediaHTML}


    <div class="actions">

      <button
        class="likeButton"
        type="button"
      >
        ❤️ Like (${likeCount})
      </button>

      <button
        class="shareButton"
        type="button"
      >
        ↗ Share
      </button>

    </div>


    <div class="comments">

      <strong>
        Comments
      </strong>


      <div class="commentList">

        ${
          comments ||
          `
            <p class="postTime">
              No comments yet.
            </p>
          `
        }

      </div>


      <div class="commentForm">

        <input
          type="text"
          placeholder="Write a comment..."
          class="commentInput"
        >

        <button
          type="button"
          class="commentButton"
        >
          Send
        </button>

      </div>

    </div>

  `;


  const likeButton =
    article.querySelector(
      ".likeButton"
    );


  const shareButton =
    article.querySelector(
      ".shareButton"
    );


  const commentButton =
    article.querySelector(
      ".commentButton"
    );


  likeButton.onclick =
    () => toggleLike(post);


  shareButton.onclick =
    () => sharePost(post);


  commentButton.onclick =
    async () => {

      const input =
        article.querySelector(
          ".commentInput"
        );


      const body =
        input.value.trim();


      if (!body) {
        return;
      }


      await addComment(
        post.id,
        body
      );


      input.value = "";


      await loadFeed();

    };


  return article;

}


/* =========================================
   LIKE
========================================= */

async function toggleLike(post) {

  try {

    const {
      data: {
        user
      }
    } =
      await supabaseClient.auth.getUser();


    if (!user) {
      return;
    }


    const existingLike =
      (post.likes || [])
        .find(
          like =>
            like.user_id ===
            user.id
        );


    if (existingLike) {

      const {
        error
      } =
        await supabaseClient
          .from("likes")
          .delete()
          .eq(
            "id",
            existingLike.id
          );


      if (error) {
        alert(error.message);
      }

    } else {

      const {
        error
      } =
        await supabaseClient
          .from("likes")
          .insert({

            post_id:
              post.id,

            user_id:
              user.id

          });


      if (error) {
        alert(error.message);
      }

    }


    await loadFeed();

  } catch (error) {

    console.error(
      "Like error:",
      error
    );

  }

}


