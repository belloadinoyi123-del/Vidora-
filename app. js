/* =========================================================
   20. SHARE POST
   ========================================================= */

async function sharePost(url) {
  if (!url) {
    return;
  }

  try {
    if (
      navigator.share &&
      typeof navigator.share === "function"
    ) {
      await navigator.share({
        title: "Vidora",
        text: "Check out this post on Vidora!",
        url: url
      });

      return;
    }

    if (
      navigator.clipboard &&
      navigator.clipboard.writeText
    ) {
      await navigator.clipboard.writeText(url);

      alert(
        "Post link copied!"
      );

      return;
    }

    window.prompt(
      "Copy this link:",
      url
    );

  } catch (error) {
    console.log(
      "Share cancelled or unavailable."
    );
  }
}


/* =========================================================
   21. SHOW PAGE
   ========================================================= */

function showPage(page) {
  const pages = [
    "home",
    "discover",
    "create",
    "chat",
    "profile",
    "notifications"
  ];

  pages.forEach(function(name) {
    const screen =
      $(name + "Screen");

    if (!screen) {
      return;
    }

    if (name === page) {
      screen.classList.remove("hidden");
    } else {
      screen.classList.add("hidden");
    }
  });

  updateNavigation(page);

  /*
    Load relevant information when opening pages.
  */

  if (page === "home") {
    loadFeed();
  }

  if (page === "discover") {
    searchPosts();
  }

  if (page === "profile") {
    loadProfile();
  }
}


/*
  Your HTML uses BOTH:
  showPage(...)
  and
  showpage(...)

  JavaScript is case-sensitive,
  so we support both.
*/

function showpage(page) {
  showPage(page);
}


/* =========================================================
   22. UPDATE BOTTOM NAVIGATION
   ========================================================= */

function updateNavigation(activePage) {
  const buttons =
    document.querySelectorAll(
      "nav button, .bottom-nav button, .nav button"
    );

  buttons.forEach(function(button) {
    button.classList.remove("active");

    const text =
      (button.textContent || "")
        .trim()
        .toLowerCase();

    if (
      activePage === "home" &&
      text.includes("home")
    ) {
      button.classList.add("active");
    }

    if (
      activePage === "discover" &&
      text.includes("discover")
    ) {
      button.classList.add("active");
    }

    if (
      activePage === "create" &&
      text.includes("create")
    ) {
      button.classList.add("active");
    }

    if (
      activePage === "chat" &&
      text.includes("chat")
    ) {
      button.classList.add("active");
    }

    if (
      activePage === "profile" &&
      text.includes("profile")
    ) {
      button.classList.add("active");
    }
  });
}


/* =========================================================
   23. SEARCH POSTS
   ========================================================= */

let searchTimer = null;


function searchPosts() {
  clearTimeout(searchTimer);

  searchTimer = setTimeout(
    performSearch,
    300
  );
}


async function performSearch() {
  const input =
    $("searchInput");

  const results =
    $("discoverResults");

  if (!results) {
    return;
  }

  if (!supabaseClient) {
    results.innerHTML =
      "<p>Supabase is not connected.</p>";
    return;
  }

  const query =
    input
      ? input.value.trim()
      : "";

  if (!query) {
    results.innerHTML =
      "<p>Search for posts...</p>";
    return;
  }

  results.innerHTML =
    "<p>Searching...</p>";

  try {
    const result =
      await supabaseClient
        .from("posts")
        .select(
          "id,user_id,media_url,media_type,caption,created_at"
        )
        .ilike(
          "caption",
          "%" + query + "%"
        )
        .order(
          "created_at",
          {
            ascending: false
          }
        );

    if (result.error) {
      console.error(
        "Search error:",
        result.error
      );

      results.innerHTML =
        "<p>Search failed.</p>";

      return;
    }

    const posts =
      result.data || [];

    if (!posts.length) {
      results.innerHTML =
        "<p>No posts found.</p>";
      return;
    }

    results.innerHTML = "";

    for (const post of posts) {
      const element =
        await createPostElement(post);

      results.appendChild(element);
    }

  } catch (error) {
    console.error(
      "Search error:",
      error
    );

    results.innerHTML =
      "<p>Search failed.</p>";
  }
}


/* =========================================================
   24. CHECK SESSION
   ========================================================= */

async function checkSession() {
  if (!supabaseClient) {
    showAuthScreen();

    setMessage(
      "authMessage",
      "Supabase could not be loaded.",
      "error"
    );

    return;
  }

  try {
    const result =
      await supabaseClient.auth.getSession();

    if (result.error) {
      console.error(
        "Session error:",
        result.error
      );

      showAuthScreen();

      return;
    }

    const session =
      result.data
        ? result.data.session
        : null;

    if (session && session.user) {
      await showApp();
    } else {
      showAuthScreen();
    }

  } catch (error) {
    console.error(
      "Check session error:",
      error
    );

    showAuthScreen();
  }
}


/* =========================================================
   25. AUTH STATE LISTENER
   ========================================================= */

if (supabaseClient) {
  supabaseClient.auth.onAuthStateChange(
    async function(event, session) {
      console.log(
        "Auth event:",
        event
      );

      /*
        Do not call showApp repeatedly for
        every auth event. Only respond to
        the important state changes.
      */

      if (
        event === "SIGNED_IN" &&
        session &&
        session.user
      ) {
        await showApp();
      }

      if (
        event === "SIGNED_OUT"
      ) {
        showAuthScreen();
      }
    }
  );
}


