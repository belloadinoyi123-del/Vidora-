/* =========================================================
   12. CREATE POST
   ========================================================= */

async function createPost(
  file,
  caption,
  messageElement
) {
  if (!supabaseClient) {
    setMessage(
      messageElement,
      "Supabase is not connected.",
      "error"
    );
    return;
  }

  const validation =
    validateMediaFile(file);

  if (!validation.valid) {
    setMessage(
      messageElement,
      validation.message,
      "error"
    );
    return;
  }

  try {
    const userResult =
      await supabaseClient.auth.getUser();

    const user = userResult.data
      ? userResult.data.user
      : null;

    if (!user) {
      setMessage(
        messageElement,
        "You must log in first.",
        "error"
      );

      showAuthScreen();

      return;
    }

    setMessage(
      messageElement,
      "Uploading..."
    );

    const fileName =
      createUniqueFileName(file);

    const filePath =
      user.id + "/" + fileName;

    const mediaType =
      file.type.startsWith("video/")
        ? "video"
        : "image";

    /*
      Upload to Supabase Storage.
      Bucket name: media
    */

    const uploadResult =
      await supabaseClient
        .storage
        .from("media")
        .upload(
          filePath,
          file,
          {
            cacheControl: "3600",
            upsert: false,
            contentType: file.type
          }
        );

    if (uploadResult.error) {
      console.error(
        "Storage upload error:",
        uploadResult.error
      );

      setMessage(
        messageElement,
        "Upload failed: " +
          uploadResult.error.message,
        "error"
      );

      return;
    }

    /*
      Get public URL.
      Your media bucket must be PUBLIC
      for this URL to display directly.
    */

    const publicUrlResult =
      supabaseClient
        .storage
        .from("media")
        .getPublicUrl(filePath);

    const publicUrl =
      publicUrlResult.data
        ? publicUrlResult.data.publicUrl
        : null;

    if (!publicUrl) {
      setMessage(
        messageElement,
        "Could not create media URL.",
        "error"
      );

      /*
        Clean up uploaded file.
      */

      await supabaseClient
        .storage
        .from("media")
        .remove([filePath]);

      return;
    }

    setMessage(
      messageElement,
      "Saving post..."
    );

    /*
      Save post information in database.
    */

    const insertResult =
      await supabaseClient
        .from("posts")
        .insert({
          user_id: user.id,
          media_url: publicUrl,
          media_type: mediaType,
          caption: caption
        })
        .select()
        .single();

    if (insertResult.error) {
      console.error(
        "Post database error:",
        insertResult.error
      );

      /*
        Remove orphaned storage file
        if database insertion fails.
      */

      await supabaseClient
        .storage
        .from("media")
        .remove([filePath]);

      setMessage(
        messageElement,
        "Post could not be saved: " +
          insertResult.error.message,
        "error"
      );

      return;
    }

    setMessage(
      messageElement,
      "Posted successfully!",
      "success"
    );

    /*
      Clear upload form.
    */

    if (fileInputExists("mediaFile")) {
      $("mediaFile").value = "";
    }

    if (fileInputExists("postCaption")) {
      $("postCaption").value = "";
    }

    if (fileInputExists("createFile")) {
      $("createFile").value = "";
    }

    if (fileInputExists("createCaption")) {
      $("createCaption").value = "";
    }

    await loadFeed();

  } catch (error) {
    console.error(
      "Create post error:",
      error
    );

    setMessage(
      messageElement,
      "Error: " + error.message,
      "error"
    );
  }
}


