/* =========================================================
   11. CREATE / UPLOAD POST
   ========================================================= */

async function createPost(
  file,
  caption,
  messageId,
  fileInputId,
  captionInputId
) {

  const message = $(messageId);

  try {

    const result =
      await supabaseClient.auth.getUser();

    const user = result.data?.user;

    if (!user) {

      if (message) {
        message.textContent =
          "Please log in again.";
      }

      return false;
    }

    if (!file.type.startsWith("image/") &&
        !file.type.startsWith("video/")) {

      if (message) {
        message.textContent =
          "Only images and videos are allowed.";
      }

      return false;
    }

    if (message) {
      message.textContent =
        "Uploading...";
    }

    /*
      IMPORTANT:
      Your Supabase Storage bucket is expected
      to be named exactly:

      media
    */

    const extension =
      file.name.includes(".")
        ? file.name
            .split(".")
            .pop()
            .toLowerCase()
        : "file";

    const fileName =
      crypto.randomUUID() +
      "." +
      extension;

    const filePath =
      user.id + "/" + fileName;

    const uploadResult =
      await supabaseClient.storage
        .from("media")
        .upload(
          filePath,
          file,
          {
            contentType: file.type,
            upsert: false
          }
        );

    if (uploadResult.error) {

      console.error(
        "Storage error:",
        uploadResult.error
      );

      if (message) {
        message.textContent =
          uploadResult.error.message;
      }

      return false;
    }

    /*
      Get public URL.
      This requires the "media" bucket to be public.
    */

    const publicResult =
      supabaseClient.storage
        .from("media")
        .getPublicUrl(filePath);

    const mediaUrl =
      publicResult.data?.publicUrl;

    if (!mediaUrl) {

      if (message) {
        message.textContent =
          "Could not create media URL.";
      }

      return false;
    }

    const mediaType =
      file.type.startsWith("video/")
        ? "video"
        : "image";

    /*
      Insert post into the posts table.
    */

    const postResult =
      await supabaseClient
        .from("posts")
        .insert({
          user_id: user.id,
          media_url: mediaUrl,
          media_type: mediaType,
          caption: caption
        });

    if (postResult.error) {

      console.error(
        "Posts table error:",
        postResult.error
      );

      if (message) {
        message.textContent =
          postResult.error.message;
      }

      return false;
    }

    if (message) {
      message.textContent =
        "Published successfully!";
    }

    const fileInput =
      $(fileInputId);

    const captionInput =
      $(captionInputId);

    if (fileInput) {
      fileInput.value = "";
    }

    if (captionInput) {
      captionInput.value = "";
    }

    await loadFeed();

    return true;

  } catch (error) {

    console.error(
      "Create post error:",
      error
    );

    if (message) {
      message.textContent =
        error.message ||
        "Upload failed.";
    }

    return false;
  }
}


/* =========================================================
   12. LOAD FEED
   ========================================================= */

async function loadFeed() {

  const feed = $("feed");

  if (!feed) {
    return;
  }

  feed.innerHTML =
    `<div class="loading">
      Loading Vidora...
    </div>`;

  try {

    /*
      Keep this query simple.
      It only requires the posts table and avoids
      breaking the feed because a profiles/likes/comments
      relationship is not configured yet.
    */

    const result =
      await supabaseClient
        .from("posts")
        .select(
          "id,user_id,media_url,media_type,caption,created_at"
        )
        .order(
          "created_at",
          {
            ascending: false
          }
        );

    const data = result.data;
    const error = result.error;

    if (error) {

      console.error(
        "Feed error:",
        error
      );

      feed.innerHTML =
        `<div class="post">
          <h3>Could not load posts</h3>
          <p>${escapeHTML(error.message)}</p>
        </div>`;

      return;
    }

    if (!data || data.length === 0) {

      feed.innerHTML =
        `<div class="post">
          <h3>No posts yet</h3>
          <p>Be the first person to publish on Vidora!</p>
        </div>`;

      return;
    }

    feed.innerHTML = "";

    data.forEach(function(post) {

      feed.appendChild(
        createPostElement(post)
      );

    });

  } catch (error) {

    console.error(
      "Feed error:",
      error
    );

    feed.innerHTML =
      `<div class="post">
        <h3>Something went wrong</h3>
        <p>${escapeHTML(error.message)}</p>
      </div>`;
  }
}


/* =========================================================
   13. CREATE FEED POST ELEMENT
   ========================================================= */

function createPostElement(post) {

  const article =
    document.createElement("article");

  article.className = "post";

  const username =
    "Vidora User";

  const initial =
    username.charAt(0);

  let mediaHTML = "";

  if (post.media_type === "video") {

    mediaHTML = `
      <video
        class="postMedia"
        controls
        playsinline
        preload="metadata"
        src="${escapeHTML(post.media_url)}">
      </video>
    `;

  } else {

    mediaHTML = `
      <img
        class="postMedia"
        src="${escapeHTML(post.media_url)}"
        alt="Vidora post"
        loading="lazy">
    `;
  }

  const captionHTML =
    post.caption
      ? `
        <div class="postCaption">
          ${escapeHTML(post.caption)}
        </div>
      `
      : "";

  article.innerHTML = `

    <div class="postHeader">

      <div class="avatar">
        ${escapeHTML(initial)}
      </div>

      <div>

        <div class="postUser">
          @${escapeHTML(username)}
        </div>

        <div class="postTime">
          ${post.created_at
            ? new Date(
                post.created_at
              ).toLocaleString()
            : ""}
        </div>

      </div>

    </div>

    ${captionHTML}

    ${mediaHTML}

    <div class="actions">

      <button
        class="likeButton"
        type="button">
        ❤️ Like
      </button>

      <button
        class="shareButton"
        type="button">
        ↗ Share
      </button>

    </div>

    <div class="comments">

      <strong>
        Comments
      </strong>

      <div class="commentForm">

        <input
          type="text"
          class="commentInput"
          placeholder="Write a comment...">

        <button
          type="button"
          class="commentButton">
          Send
        </button>

      </div>

    </div>

  `;

  const likeButton =
    article.querySelector(
      ".likeButton"
    );

  const shareButton =
    article.querySelector(
      ".shareButton"
    );

  const commentButton =
    article.querySelector(
      ".commentButton"
    );

  if (likeButton) {

    likeButton.onclick =
      function() {
        toggleLike(post);
      };

  }

  if (shareButton) {

    shareButton.onclick =
      function() {
        sharePost(post);
      };

  }

  if (commentButton) {

    commentButton.onclick =
      async function() {

        const input =
          article.querySelector(
            ".commentInput"
          );

        if (!input) {
          return;
        }

        const body =
          input.value.trim();

        if (!body) {
          return;
        }

        const success =
          await addComment(
            post.id,
            body
          );

        if (success) {
          input.value = "";
        }
      };
  }

  return article;
}


/* =========================================================
   14. LIKE
   ========================================================= */

async function toggleLike(post) {

  try {

    const result =
      await supabaseClient.auth.getUser();

    const user = result.data?.user;

    if (!user) {

      alert(
        "Please log in to like posts."
      );

      return;
    }

    /*
      This requires a "likes" table with:
      post_id
      user_id
    */

    const existing =
      await supabaseClient
        .from("likes")
        .select("id")
        .eq(
          "post_id",
          post.id
        )
        .eq(
          "user_id",
          user.id
        )
        .maybeSingle();

    if (existing.error) {

      alert(
        "Likes are not configured yet: " +
        existing.error.message
      );

      return;
    }

    if (existing.data) {

      const resultDelete =
        await supabaseClient
          .from("likes")
          .delete()
          .eq(
            "id",
            existing.data.id
          );

      if (resultDelete.error) {
        alert(resultDelete.error.message);
        return;
      }

    } else {

      const resultInsert =
        await supabaseClient
          .from("likes")
          .insert({
            post_id: post.id,
            user_id: user.id
          });

      if (resultInsert.error) {
        alert(resultInsert.error.message);
        return;
      }
    }

    await loadFeed();

  } catch (error) {

    console.error(
      "Like error:",
      error
    );

    alert(
      error.message ||
      "Could not like post."
    );
  }
}


