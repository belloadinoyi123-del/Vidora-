/* =========================================
   SHARE
========================================= */

async function sharePost(post) {

  try {

    if (
      navigator.share
    ) {

      await navigator.share({

        title:
          "Vidora",

        text:
          "Check out this Vidora post!",

        url:
          post.media_url

      });

    } else if (
      navigator.clipboard
    ) {

      await navigator.clipboard.writeText(
        post.media_url
      );


      alert(
        "Post link copied!"
      );

    } else {

      alert(
        post.media_url
      );

    }

  } catch (error) {

    console.log(
      "Share cancelled:",
      error
    );

  }

}


